# Enforce Linux (LF) line endings for all text files on every platform.
* text=auto eol=lf

# Binary assets — do not line-end convert.
*.jpg binary
*.jpeg binary
*.JPG binary
*.JPEG binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Shell entrypoints (LF + executable in git).
install.sh text eol=lf
configure.sh text eol=lf
scripts/ci.sh text eol=lf
scripts/auto-update.sh text eol=lf
