# Template — placeholders @ROOT@ @USER@ filled by rain-bypass-install.
[Unit]
Description=Daily auto-update for Sprinkler Rain Bypass (apt dist-upgrade, git pull, pip, service restart)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/scripts/auto-update.sh
Nice=10
