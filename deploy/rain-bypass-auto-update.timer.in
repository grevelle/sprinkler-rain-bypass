# Template — no placeholders; installed by rain-bypass-install.
[Unit]
Description=Daily auto-update timer for Sprinkler Rain Bypass

[Timer]
# 04:00 local — after midnight check and typical 1 AM irrigation window.
OnCalendar=*-*-* 04:00:00
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
