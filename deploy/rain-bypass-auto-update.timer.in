# Template — no placeholders; installed by rain-bypass-install.
[Unit]
Description=Daily auto-update timer for Sprinkler Rain Bypass

[Timer]
# 12:00 local — midday OS dist-upgrade + app update (git pull, pip, service restart).
OnCalendar=*-*-* 12:00:00
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
