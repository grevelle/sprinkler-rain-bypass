# Template — no placeholders; installed by rain-bypass-install.
[Unit]
Description=Wi-Fi watchdog timer for Sprinkler Rain Bypass

[Timer]
# First check 5 minutes after boot (grace for slow Zero W associate), then every 5 minutes.
OnBootSec=5min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
