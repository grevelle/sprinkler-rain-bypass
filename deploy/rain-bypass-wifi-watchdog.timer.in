# Template — no placeholders; installed by rain-bypass-install.
[Unit]
Description=Wi-Fi watchdog timer for Sprinkler Rain Bypass

[Timer]
# First check 10 minutes after boot (aligns with script boot grace), then every 5 minutes.
OnBootSec=10min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
