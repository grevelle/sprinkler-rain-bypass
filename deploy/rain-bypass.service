# Template — paths are filled by install.sh. Manual install: edit ExecStart and WorkingDirectory.
[Unit]
Description=Sprinkler rain bypass controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sprinkler-rain-bypass
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sprinkler-rain-bypass/.venv/bin/python -m rain_bypass --config /opt/sprinkler-rain-bypass/settings.toml
Restart=on-failure
RestartSec=300

[Install]
WantedBy=multi-user.target
