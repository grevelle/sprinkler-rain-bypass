# Template — placeholders @ROOT@ @PYTHON@ @SETTINGS@ @USER@ filled by rain-bypass-install.
[Unit]
Description=Sprinkler rain bypass read-only web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m rain_bypass serve --config @SETTINGS@
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=30
MemoryMax=256M
Nice=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
