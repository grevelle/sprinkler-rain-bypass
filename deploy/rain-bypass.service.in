# Template — placeholders @ROOT@ @PYTHON@ @SETTINGS@ @USER@ filled by rain-bypass-install.
[Unit]
Description=Sprinkler rain bypass controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m rain_bypass --config @SETTINGS@
Restart=on-failure
RestartSec=300
# Pi Zero W (512 MB RAM): cap this service and deprioritize vs other workloads.
MemoryMax=256M
Nice=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
